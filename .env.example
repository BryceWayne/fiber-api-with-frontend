# Database Configuration
# Choose between "memory" (default) or "firebase"
DB_TYPE=memory

# Firebase Configuration (only needed if DB_TYPE=firebase)
# Your Google Cloud Project ID
FIREBASE_PROJECT_ID=your-project-id

# Firestore collection name (default: books)
FIREBASE_COLLECTION=books

# Path to your Firebase service account JSON key file
# Download this from Google Cloud Console > IAM & Admin > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
